{
	"Research: Start": {
		"prefix": "research-start",
		"body": [
			"@workspace #file:PROMPTS.md Execute 'Plan' for topic: ${1:TOPIC}. Date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE."
		],
		"description": "1. Initialize Research Plan"
	},
	"Research: Ingest": {
		"prefix": "research-ingest",
		"body": [
			"@workspace #folder:workspace/sources #file:PROMPTS.md Execute 'Ingest' regarding: ${1:TOPIC}."
		],
		"description": "2. Analyze Sources (Quality & Themes)"
	},
	"Research: Outline": {
		"prefix": "research-outline",
		"body": [
			"@workspace #file:PROMPTS.md Execute 'Outline' for title: \"${1:TITLE}\"."
		],
		"description": "3. Create Structured Outline"
	},
	"Research: Draft": {
		"prefix": "research-draft",
		"body": [
			"@workspace #file:$TM_FILENAME #file:PROMPTS.md Execute 'Draft' for section: \"${1:SECTION_NAME}\". Date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE."
		],
		"description": "4. Draft Content (with CoT)"
	},
	"Research: Critique": {
		"prefix": "research-critique",
		"body": [
			"@workspace #file:$TM_FILENAME #file:PROMPTS.md Execute 'Critique' on this draft."
		],
		"description": "5. Review & Challenge (Governance Check)"
	},
	"Research: Synthesize": {
		"prefix": "research-synthesize",
		"body": [
			"@workspace #file:$TM_FILENAME #file:PROMPTS.md Execute 'Synthesize' to generate Executive Summary."
		],
		"description": "6. Generate Executive Summary"
	},
	"Research: Diagram": {
		"prefix": "research-diagram",
		"body": [
			"@workspace #folder:workspace/sources #file:PROMPTS.md Execute 'Diagram' for: ${1:CONCEPT}."
		],
		"description": "7. Visualize Concepts"
	}
}
